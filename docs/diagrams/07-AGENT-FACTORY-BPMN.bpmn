<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AgentFactoryBPMN" targetNamespace="http://agent-factory.ai/bpmn" exporter="agent-factory" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_AgentFactory">
    <bpmn:participant id="Part_Human" name="Human / Operator" processRef="Proc_Human"/>
    <bpmn:participant id="Part_AgentFactory" name="Agent Factory" processRef="Proc_AgentFactory"/>
    <bpmn:participant id="Part_Backend" name="Coding Backend" processRef="Proc_Backend"/>
    <bpmn:messageFlow id="MF_01" name="User request" sourceRef="SE_Human" targetRef="SE_Request"/>
    <bpmn:messageFlow id="MF_02" name="Clarification question" sourceRef="T_RelayClarify" targetRef="H_ClarifyCatch"/>
    <bpmn:messageFlow id="MF_03" name="Clarification reply" sourceRef="H_SendClarify" targetRef="T_ForwardClarify"/>
    <bpmn:messageFlow id="MF_04" name="Approval request" sourceRef="T_RelayApproval" targetRef="H_ApprovalCatch"/>
    <bpmn:messageFlow id="MF_05" name="Approval decision" sourceRef="H_SendDecision" targetRef="T_ForwardDecision"/>
    <bpmn:messageFlow id="MF_06" name="Final summary" sourceRef="T_RelaySummary" targetRef="H_SummaryCatch"/>
    <bpmn:messageFlow id="MF_07" name="Backend instruction" sourceRef="A_Execute" targetRef="SE_Backend"/>
    <bpmn:messageFlow id="MF_08" name="Backend result" sourceRef="B_ReturnResult" targetRef="A_BackendReply"/>
  </bpmn:collaboration>

  <bpmn:dataStore id="DataStore_Persistent" name="Persistent State / Logs"/>
  <bpmn:dataStoreReference id="DS_Persistent" name="Persistent State / Logs" dataStoreRef="DataStore_Persistent"/>

  <bpmn:process id="Proc_Human" isExecutable="false">
    <bpmn:startEvent id="SE_Human" name="Send request">
      <bpmn:messageEventDefinition id="MED_SE_Human"/>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="H_ClarifyCatch" name="Receive clarification request">
      <bpmn:messageEventDefinition id="MED_H_ClarifyCatch"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="H_SendClarify" name="Send clarification"/>
    <bpmn:intermediateCatchEvent id="H_ApprovalCatch" name="Receive approval request">
      <bpmn:messageEventDefinition id="MED_H_ApprovalCatch"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="H_SendDecision" name="Send approval or rejection"/>
    <bpmn:intermediateCatchEvent id="H_SummaryCatch" name="Receive summary">
      <bpmn:messageEventDefinition id="MED_H_SummaryCatch"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EE_Human" name="Done"/>
    <bpmn:sequenceFlow id="SF_H1" sourceRef="SE_Human" targetRef="H_ClarifyCatch"/>
    <bpmn:sequenceFlow id="SF_H2" sourceRef="H_ClarifyCatch" targetRef="H_SendClarify"/>
    <bpmn:sequenceFlow id="SF_H3" sourceRef="H_SendClarify" targetRef="H_ApprovalCatch"/>
    <bpmn:sequenceFlow id="SF_H4" sourceRef="H_ApprovalCatch" targetRef="H_SendDecision"/>
    <bpmn:sequenceFlow id="SF_H5" sourceRef="H_SendDecision" targetRef="H_SummaryCatch"/>
    <bpmn:sequenceFlow id="SF_H6" sourceRef="H_SummaryCatch" targetRef="EE_Human"/>
  </bpmn:process>

  <bpmn:process id="Proc_AgentFactory" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AgentFactory">
      <bpmn:lane id="Lane_Telegram" name="Telegram Interface">
        <bpmn:flowNodeRef>SE_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ForwardRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RelayClarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ForwardClarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RelayApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ForwardDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RelaySummary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_AgentFactory</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Orchestrator" name="Orchestrator">
        <bpmn:flowNodeRef>O_Classify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O_Bundle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O_PersistRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O_PersistDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O_PersistOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O_ReturnSummary</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Specialist" name="Specialist Agent">
        <bpmn:flowNodeRef>A_Inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ClarifyDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ClarifyReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_AssessRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_RequestApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ApprovalReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Execute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_BackendReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ExecSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_PackageSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_PackageFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_PackageRejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="SE_Request" name="Request received">
      <bpmn:messageEventDefinition id="MED_SE_Request"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="T_ForwardRequest" name="Forward request to orchestrator"/>
    <bpmn:serviceTask id="O_Classify" name="Classify intent"/>
    <bpmn:serviceTask id="O_Select" name="Select agent"/>
    <bpmn:serviceTask id="O_Bundle" name="Prepare bounded task"/>
    <bpmn:serviceTask id="O_PersistRequest" name="Persist request state">
      <bpmn:ioSpecification>
        <bpmn:dataOutput id="DO_RequestState" name="request_state"/>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="DOA_RequestState">
        <bpmn:sourceRef>DO_RequestState</bpmn:sourceRef>
        <bpmn:targetRef>DS_Persistent</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="A_Inspect" name="Inspect task"/>
    <bpmn:exclusiveGateway id="GW_Missing" name="Missing information?"/>
    <bpmn:serviceTask id="A_ClarifyDraft" name="Draft clarification question"/>
    <bpmn:serviceTask id="T_RelayClarify" name="Relay clarification request"/>
    <bpmn:serviceTask id="T_ForwardClarify" name="Forward clarification to specialist"/>
    <bpmn:serviceTask id="A_ClarifyReply" name="Receive clarification answer"/>
    <bpmn:serviceTask id="A_AssessRisk" name="Assess risk"/>
    <bpmn:exclusiveGateway id="GW_Risk" name="Risk / destructive action?"/>
    <bpmn:serviceTask id="A_RequestApproval" name="Request approval"/>
    <bpmn:serviceTask id="T_RelayApproval" name="Relay approval request"/>
    <bpmn:serviceTask id="T_ForwardDecision" name="Forward approval decision"/>
    <bpmn:serviceTask id="A_ApprovalReply" name="Receive approval decision"/>
    <bpmn:serviceTask id="O_PersistDecision" name="Persist decision">
      <bpmn:ioSpecification>
        <bpmn:dataOutput id="DO_DecisionState" name="decision_state"/>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="DOA_DecisionState">
        <bpmn:sourceRef>DO_DecisionState</bpmn:sourceRef>
        <bpmn:targetRef>DS_Persistent</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Approved" name="Approved?"/>
    <bpmn:sendTask id="A_Execute" name="Execute via coding backend"/>
    <bpmn:serviceTask id="A_BackendReply" name="Receive backend result"/>
    <bpmn:exclusiveGateway id="GW_ExecSuccess" name="Execution successful?"/>
    <bpmn:serviceTask id="A_PackageSuccess" name="Package success"/>
    <bpmn:serviceTask id="A_PackageFailure" name="Package failure"/>
    <bpmn:serviceTask id="A_PackageRejected" name="Package rejection"/>
    <bpmn:serviceTask id="O_PersistOutcome" name="Persist outcome">
      <bpmn:ioSpecification>
        <bpmn:dataOutput id="DO_OutcomeState" name="outcome_state"/>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="DOA_OutcomeState">
        <bpmn:sourceRef>DO_OutcomeState</bpmn:sourceRef>
        <bpmn:targetRef>DS_Persistent</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="O_ReturnSummary" name="Return summary"/>
    <bpmn:endEvent id="EE_AgentFactory" name="Delivered"/>

    <bpmn:sequenceFlow id="SF_AF1" sourceRef="SE_Request" targetRef="T_ForwardRequest"/>
    <bpmn:sequenceFlow id="SF_AF2" sourceRef="T_ForwardRequest" targetRef="O_Classify"/>
    <bpmn:sequenceFlow id="SF_AF3" sourceRef="O_Classify" targetRef="O_Select"/>
    <bpmn:sequenceFlow id="SF_AF4" sourceRef="O_Select" targetRef="O_Bundle"/>
    <bpmn:sequenceFlow id="SF_AF5" sourceRef="O_Bundle" targetRef="O_PersistRequest"/>
    <bpmn:sequenceFlow id="SF_AF6" sourceRef="O_PersistRequest" targetRef="A_Inspect"/>
    <bpmn:sequenceFlow id="SF_AF7" sourceRef="A_Inspect" targetRef="GW_Missing"/>
    <bpmn:sequenceFlow id="SF_AF8" sourceRef="GW_Missing" targetRef="A_ClarifyDraft" name="Yes"/>
    <bpmn:sequenceFlow id="SF_AF9" sourceRef="A_ClarifyDraft" targetRef="T_RelayClarify"/>
    <bpmn:sequenceFlow id="SF_AF10" sourceRef="T_RelayClarify" targetRef="T_ForwardClarify"/>
    <bpmn:sequenceFlow id="SF_AF11" sourceRef="T_ForwardClarify" targetRef="A_ClarifyReply"/>
    <bpmn:sequenceFlow id="SF_AF12" sourceRef="A_ClarifyReply" targetRef="A_AssessRisk"/>
    <bpmn:sequenceFlow id="SF_AF13" sourceRef="GW_Missing" targetRef="A_AssessRisk" name="No"/>
    <bpmn:sequenceFlow id="SF_AF14" sourceRef="A_AssessRisk" targetRef="GW_Risk"/>
    <bpmn:sequenceFlow id="SF_AF15" sourceRef="GW_Risk" targetRef="A_RequestApproval" name="Yes"/>
    <bpmn:sequenceFlow id="SF_AF16" sourceRef="A_RequestApproval" targetRef="T_RelayApproval"/>
    <bpmn:sequenceFlow id="SF_AF17" sourceRef="T_RelayApproval" targetRef="T_ForwardDecision"/>
    <bpmn:sequenceFlow id="SF_AF18" sourceRef="T_ForwardDecision" targetRef="A_ApprovalReply"/>
    <bpmn:sequenceFlow id="SF_AF19" sourceRef="A_ApprovalReply" targetRef="O_PersistDecision"/>
    <bpmn:sequenceFlow id="SF_AF20" sourceRef="O_PersistDecision" targetRef="GW_Approved"/>
    <bpmn:sequenceFlow id="SF_AF21" sourceRef="GW_Risk" targetRef="A_Execute" name="No"/>
    <bpmn:sequenceFlow id="SF_AF22" sourceRef="GW_Approved" targetRef="A_Execute" name="Yes"/>
    <bpmn:sequenceFlow id="SF_AF23" sourceRef="GW_Approved" targetRef="A_PackageRejected" name="No"/>
    <bpmn:sequenceFlow id="SF_AF24" sourceRef="A_Execute" targetRef="A_BackendReply"/>
    <bpmn:sequenceFlow id="SF_AF25" sourceRef="A_BackendReply" targetRef="GW_ExecSuccess"/>
    <bpmn:sequenceFlow id="SF_AF26" sourceRef="GW_ExecSuccess" targetRef="A_PackageSuccess" name="Yes"/>
    <bpmn:sequenceFlow id="SF_AF27" sourceRef="GW_ExecSuccess" targetRef="A_PackageFailure" name="No"/>
    <bpmn:sequenceFlow id="SF_AF28" sourceRef="A_PackageRejected" targetRef="O_PersistOutcome"/>
    <bpmn:sequenceFlow id="SF_AF29" sourceRef="A_PackageSuccess" targetRef="O_PersistOutcome"/>
    <bpmn:sequenceFlow id="SF_AF30" sourceRef="A_PackageFailure" targetRef="O_PersistOutcome"/>
    <bpmn:sequenceFlow id="SF_AF31" sourceRef="O_PersistOutcome" targetRef="O_ReturnSummary"/>
    <bpmn:sequenceFlow id="SF_AF32" sourceRef="O_ReturnSummary" targetRef="T_RelaySummary"/>
    <bpmn:sequenceFlow id="SF_AF33" sourceRef="T_RelaySummary" targetRef="EE_AgentFactory"/>
  </bpmn:process>

  <bpmn:process id="Proc_Backend" isExecutable="false">
    <bpmn:startEvent id="SE_Backend" name="Instruction received">
      <bpmn:messageEventDefinition id="MED_SE_Backend"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="B_Apply" name="Apply code changes"/>
    <bpmn:serviceTask id="B_RunChecks" name="Run checks"/>
    <bpmn:serviceTask id="B_ReturnResult" name="Return result"/>
    <bpmn:endEvent id="EE_Backend" name="Result returned"/>
    <bpmn:sequenceFlow id="SF_B1" sourceRef="SE_Backend" targetRef="B_Apply"/>
    <bpmn:sequenceFlow id="SF_B2" sourceRef="B_Apply" targetRef="B_RunChecks"/>
    <bpmn:sequenceFlow id="SF_B3" sourceRef="B_RunChecks" targetRef="B_ReturnResult"/>
    <bpmn:sequenceFlow id="SF_B4" sourceRef="B_ReturnResult" targetRef="EE_Backend"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_AgentFactory">
    <bpmndi:BPMNPlane id="Plane_AgentFactory" bpmnElement="Collab_AgentFactory">
      <bpmndi:BPMNShape id="Shape_Part_Human" bpmnElement="Part_Human" isHorizontal="true">
        <dc:Bounds x="0" y="20" width="2600" height="170"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Part_AgentFactory" bpmnElement="Part_AgentFactory" isHorizontal="true">
        <dc:Bounds x="0" y="210" width="2600" height="1000"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Part_Backend" bpmnElement="Part_Backend" isHorizontal="true">
        <dc:Bounds x="0" y="1240" width="2600" height="170"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Telegram" bpmnElement="Lane_Telegram" isHorizontal="true">
        <dc:Bounds x="0" y="210" width="2600" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Orchestrator" bpmnElement="Lane_Orchestrator" isHorizontal="true">
        <dc:Bounds x="0" y="410" width="2600" height="250"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Specialist" bpmnElement="Lane_Specialist" isHorizontal="true">
        <dc:Bounds x="0" y="660" width="2600" height="550"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_SE_Human" bpmnElement="SE_Human">
        <dc:Bounds x="120" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_H_ClarifyCatch" bpmnElement="H_ClarifyCatch">
        <dc:Bounds x="400" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_H_SendClarify" bpmnElement="H_SendClarify">
        <dc:Bounds x="500" y="60" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_H_ApprovalCatch" bpmnElement="H_ApprovalCatch">
        <dc:Bounds x="760" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_H_SendDecision" bpmnElement="H_SendDecision">
        <dc:Bounds x="860" y="60" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_H_SummaryCatch" bpmnElement="H_SummaryCatch">
        <dc:Bounds x="1160" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EE_Human" bpmnElement="EE_Human">
        <dc:Bounds x="1280" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_SE_Request" bpmnElement="SE_Request">
        <dc:Bounds x="120" y="262" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_ForwardRequest" bpmnElement="T_ForwardRequest">
        <dc:Bounds x="220" y="240" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_O_Classify" bpmnElement="O_Classify">
        <dc:Bounds x="220" y="460" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_O_Select" bpmnElement="O_Select">
        <dc:Bounds x="400" y="460" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_O_Bundle" bpmnElement="O_Bundle">
        <dc:Bounds x="580" y="460" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_O_PersistRequest" bpmnElement="O_PersistRequest">
        <dc:Bounds x="820" y="460" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_Inspect" bpmnElement="A_Inspect">
        <dc:Bounds x="220" y="740" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Missing" bpmnElement="GW_Missing">
        <dc:Bounds x="420" y="755" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_ClarifyDraft" bpmnElement="A_ClarifyDraft">
        <dc:Bounds x="540" y="720" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_RelayClarify" bpmnElement="T_RelayClarify">
        <dc:Bounds x="760" y="240" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_ForwardClarify" bpmnElement="T_ForwardClarify">
        <dc:Bounds x="980" y="240" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_ClarifyReply" bpmnElement="A_ClarifyReply">
        <dc:Bounds x="1210" y="720" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_AssessRisk" bpmnElement="A_AssessRisk">
        <dc:Bounds x="1400" y="740" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Risk" bpmnElement="GW_Risk">
        <dc:Bounds x="1580" y="755" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_RequestApproval" bpmnElement="A_RequestApproval">
        <dc:Bounds x="1700" y="720" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_RelayApproval" bpmnElement="T_RelayApproval">
        <dc:Bounds x="1020" y="240" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_ForwardDecision" bpmnElement="T_ForwardDecision">
        <dc:Bounds x="1240" y="240" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_ApprovalReply" bpmnElement="A_ApprovalReply">
        <dc:Bounds x="1460" y="720" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_O_PersistDecision" bpmnElement="O_PersistDecision">
        <dc:Bounds x="1660" y="460" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Approved" bpmnElement="GW_Approved">
        <dc:Bounds x="1860" y="755" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_Execute" bpmnElement="A_Execute">
        <dc:Bounds x="2000" y="700" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_BackendReply" bpmnElement="A_BackendReply">
        <dc:Bounds x="2200" y="720" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_ExecSuccess" bpmnElement="GW_ExecSuccess">
        <dc:Bounds x="2410" y="755" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_PackageSuccess" bpmnElement="A_PackageSuccess">
        <dc:Bounds x="2320" y="700" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_PackageFailure" bpmnElement="A_PackageFailure">
        <dc:Bounds x="2320" y="780" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_PackageRejected" bpmnElement="A_PackageRejected">
        <dc:Bounds x="1920" y="860" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_O_PersistOutcome" bpmnElement="O_PersistOutcome">
        <dc:Bounds x="2100" y="460" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_O_ReturnSummary" bpmnElement="O_ReturnSummary">
        <dc:Bounds x="2320" y="460" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_RelaySummary" bpmnElement="T_RelaySummary">
        <dc:Bounds x="2320" y="240" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EE_AgentFactory" bpmnElement="EE_AgentFactory">
        <dc:Bounds x="2530" y="262" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DS_Persistent" bpmnElement="DS_Persistent">
        <dc:Bounds x="1120" y="1080" width="220" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_SE_Backend" bpmnElement="SE_Backend">
        <dc:Bounds x="120" y="1302" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_B_Apply" bpmnElement="B_Apply">
        <dc:Bounds x="260" y="1280" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_B_RunChecks" bpmnElement="B_RunChecks">
        <dc:Bounds x="520" y="1280" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_B_ReturnResult" bpmnElement="B_ReturnResult">
        <dc:Bounds x="760" y="1280" width="140" height="80"/>
