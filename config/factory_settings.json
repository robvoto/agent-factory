{
  "model_environment": {
    "general": "FACTORY_GENERAL_MODEL",
    "coding": "FACTORY_CODING_MODEL",
    "global": "FACTORY_MODEL"
  },
  "model_defaults": {
    "general": "luna",
    "coding": "luna"
  },
  "runtime_limits": {
    "recursion_limit": 32,
    "provider_timeout_seconds": 60,
    "max_retries": 1
  },
  "models": {
    "codex": "openai:gpt-6-luna",
    "claude": "anthropic:claude-sonnet-4-6",
    "luna": "openai:gpt-6-luna",
    "mini": "openai:gpt-4.1-mini",
    "opus": "anthropic:claude-opus-4-8"
  },
  "telegram_bots": [
    {
      "name": "factory",
      "token_env": "TELEGRAM_FACTORY_TOKEN",
      "allowed_chat_ids_env": "TELEGRAM_FACTORY_CHAT_IDS"
    }
  ]
}
